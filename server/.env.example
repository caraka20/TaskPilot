# Database development lokal dari compose.dev.yml
DATABASE_URL="mysql://taskpilot:taskpilot_dev_password@127.0.0.1:3307/taskpilot"

# Ganti dengan nilai acak, misalnya hasil: openssl rand -hex 32
JWT_SECRET_KEY="replace-with-a-long-random-secret"

PORT=3000
SALT_ROUNDS=10
DEFAULT_GAJI_PER_JAM=10000

# Modul Absensi terpadu
ATTENDANCE_TIMEZONE="Asia/Jakarta"
# Opsional. Default: <folder-server>/uploads
UPLOAD_DIR=""
# Auto-close dijalankan scheduler setiap 5 menit dan menutup sesi mulai 23:00 WIB.
# Pending hasil auto-close disetujui setelah grace period 4 jam.
